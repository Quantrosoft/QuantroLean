<Project Sdk="Microsoft.NET.Sdk">
  <!--
    NinjaScript strategies (Strategies\*.cs, written as for NinjaTrader 8) compiled together with the NinjaShim and
    the Lean host into one algorithm assembly. Lean loads it as algorithm-type-name NinjaScriptAlgorithm; the
    parameter "strategy" picks the NinjaScript class. Requires NinjaTrader 8 on this PC (src/NinjaShim/NinjaTrader8.props).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MyAlgo.NinjaScript</AssemblyName>
    <RootNamespace>NinjaTrader.NinjaScript.Strategies</RootNamespace>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- NinjaScript sources compile with warnings NinjaTrader's own compiler does not show -->
    <NoWarn>0108;0162;0168;0219;0414;0649;1591;CS8002</NoWarn>
  </PropertyGroup>
  <Import Project="..\..\NinjaHost\NinjaHost.props" />
</Project>
