<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Lean brokerage and live data source for NinjaTrader 8, through a companion NinjaTrader 8 gateway process,
    which it starts as a separate process. This project does not reference NinjaTrader; it builds without it.
    The assembly name has to start with "QuantConnect.": Lean's Composer looks for brokerages only in such assemblies.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>QuantroLean.Brokerages.NinjaTrader8</RootNamespace>
    <AssemblyName>QuantConnect.Brokerages.NinjaTrader8</AssemblyName>
    <Description>QuantroLean: NinjaTrader 8 brokerage and live data for Lean</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QuantConnect.Brokerages" />
    <PackageReference Include="QuantConnect.Common" />
    <PackageReference Include="QuantConnect.Configuration" />
    <PackageReference Include="QuantConnect.Logging" />
  </ItemGroup>
  <!--
    The NinjaTrader 8 gateway companion, binary only (no source): the obfuscated host NinjaTrader8.Gateway.exe and its
    config, plus the native core nt8native.dll. Shipped with the package so a clone builds and live-connects out of the
    box; the host updates nt8native.dll itself from the update channel. Copied next to the launcher so the default
    'ninjatrader8-gateway' path (gateway/NinjaTrader8.Gateway.exe) resolves. See gateway/README.md for provenance + SHAs.
  -->
  <ItemGroup>
    <Content Include="gateway\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>gateway\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
