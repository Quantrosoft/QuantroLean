<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Dukascopy data source for MyLean: a Lean IDataDownloader that fetches free historical tick data for forex and
    CFDs from Dukascopy's public feed. Part of this repository (referenced by MyLauncher and MyDownloader), with no
    runtime NuGet dependencies of its own (the LZMA decoder is compiled in). The Lean package versions come from
    Directory.Packages.props.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>QuantConnect.DataSource.Dukascopy</AssemblyName>
    <RootNamespace>QuantConnect.Lean.DataSource.Dukascopy</RootNamespace>
    <Product>QuantConnect LEAN Dukascopy Data Source</Product>
    <Company>Quantrosoft Pte. Ltd.</Company>
    <Description>Free Dukascopy historical tick data (forex and CFDs) as a Lean IDataDownloader.</Description>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuantConnect.Common" />
    <PackageReference Include="QuantConnect.Lean.Engine" />
    <PackageReference Include="QuantConnect.Logging" />
  </ItemGroup>
</Project>
