<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Lean launcher for NinjaScript algorithms: QuantroLeanLauncher's Program.cs (linked, not copied) on the Windows desktop
    runtime, which NinjaScript code needs (WPF types such as System.Windows.Media.Brush). Its config.json runs the
    example NinjaScript strategy (src/Algorithms/QuantroLeanAlgo.NinjaScript).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>QuantConnect.Lean.Launcher</RootNamespace>
    <AssemblyName>QuantroLeanLauncher.NinjaTrader</AssemblyName>
    <StartupObject>QuantConnect.Lean.Launcher.Program</StartupObject>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Description>QuantroLean: Lean launcher for NinjaScript algorithms</Description>
    <NoWarn>CA1062</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\QuantroLeanLauncher\Program.cs" Link="Program.cs" />
    <Compile Include="..\QuantroLeanLauncher\Properties\AssemblyInfo.cs" Link="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DynamicInterop" />
    <PackageReference Include="QuantConnect.Algorithm" />
    <PackageReference Include="QuantConnect.Algorithm.Framework" />
    <PackageReference Include="QuantConnect.AlgorithmFactory" />
    <PackageReference Include="QuantConnect.Api" />
    <PackageReference Include="QuantConnect.Brokerages" />
    <PackageReference Include="QuantConnect.Common" />
    <PackageReference Include="QuantConnect.Compression" />
    <PackageReference Include="QuantConnect.Configuration" />
    <PackageReference Include="QuantConnect.Indicators" />
    <PackageReference Include="QuantConnect.Lean.Engine" />
    <PackageReference Include="QuantConnect.Logging" />
    <PackageReference Include="QuantConnect.Messaging" />
    <PackageReference Include="QuantConnect.Optimizer" />
    <PackageReference Include="QuantConnect.Queues" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Algorithms\QuantroLeanAlgo.NinjaScript\QuantroLeanAlgo.NinjaScript.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
