<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lean's Optimizer.Launcher (unchanged copies, see README). Every backtest runs as a QuantroLeanLauncher process. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>QuantConnect.Optimizer.Launcher</RootNamespace>
    <!-- Must start with "QuantConnect.": Lean's Composer collects exported types (Program.cs looks up
         ConsoleLeanOptimizer among them) only from QuantConnect.*.dll files (Common/Util/Composer.cs). -->
    <AssemblyName>QuantConnect.Optimizer.Launcher</AssemblyName>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <Features>flow-analysis</Features>
    <Description>QuantroLean: Lean optimizer launcher</Description>
    <NoWarn>CA1062</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QuantConnect.Common" />
    <PackageReference Include="QuantConnect.Configuration" />
    <PackageReference Include="QuantConnect.Logging" />
    <PackageReference Include="QuantConnect.Optimizer" />
  </ItemGroup>
  <ItemGroup>
    <!-- build order only: the optimizer starts QuantroLeanLauncher.exe (config.json "lean-binaries-location") -->
    <ProjectReference Include="..\QuantroLeanLauncher\QuantroLeanLauncher.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
