<Project>
  <!--
    Imported by every project that compiles NinjaScript strategies into a Lean algorithm assembly: the NinjaShim, the
    Lean host (NinjaScriptAlgorithm) and NinjaTrader's stock sources of the local installation are compiled into the
    project's OWN assembly - NinjaScript's partial classes only merge within one assembly.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\NinjaShim\NinjaTrader8.props" />

  <PropertyGroup>
    <NinjaShimDir>$(MSBuildThisFileDirectory)..\NinjaShim</NinjaShimDir>
    <NinjaHostDir>$(MSBuildThisFileDirectory)</NinjaHostDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(NinjaShimDir)\**\*.cs" Exclude="$(NinjaShimDir)\bin\**;$(NinjaShimDir)\obj\**"
             Link="NinjaShim\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(NinjaHostDir)*.cs" Link="NinjaHost\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuantConnect.Algorithm" />
    <PackageReference Include="QuantConnect.Common" />
    <PackageReference Include="QuantConnect.Configuration" />
    <PackageReference Include="QuantConnect.Indicators" />
  </ItemGroup>
</Project>
