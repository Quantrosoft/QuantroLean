<Project>
  <!--
    The NinjaTrader 8 installation of this PC. Projects that compile NinjaScript code link NinjaTrader's own
    NinjaScript sources (stock indicators, bars types) from its bin\Custom folder at build time; those files belong
    to NinjaTrader and are never copied into this repository.
    Default: <Documents>\NinjaTrader 8\bin\Custom of the current user. Override: -p:NT8Custom=<path to bin\Custom>.
  -->
  <PropertyGroup>
    <NT8Custom Condition="'$(NT8Custom)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.MyDocuments))\NinjaTrader 8\bin\Custom</NT8Custom>
  </PropertyGroup>

  <Target Name="VerifyNinjaTrader8" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(NT8Custom)\Indicators\@SMA.cs')"
           Text="NinjaTrader 8 not found: '$(NT8Custom)\Indicators\@SMA.cs' does not exist. Install NinjaTrader 8 or build with -p:NT8Custom=&lt;path to NinjaTrader 8\bin\Custom&gt;." />
  </Target>

  <!-- NinjaTrader's stock indicators the NinjaShim's indicator factory methods return, linked unchanged -->
  <ItemGroup>
    <NT8StockIndicator Include="MAX;MIN;DM;VolumeUpDown;SMA;EMA;WMA;TEMA;DEMA;HMA;RSI;MACD;ADX;CCI;MFI;OBV;StdDev;Bollinger;Stochastics;StochasticsFast;VOL;SUM;Range;Momentum;TSI;Swing;ATR" />
    <Compile Include="@(NT8StockIndicator->'$(NT8Custom)\Indicators\@%(Identity).cs')" Link="NinjaTrader8\Indicators\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- NinjaTrader's bars types the shim hosts as secondary series (NINJASHIM_NT8_BARSTYPES), linked unchanged -->
  <ItemGroup>
    <Compile Include="$(NT8Custom)\BarsTypes\@RenkoBarsType.cs;$(NT8Custom)\BarsTypes\@TickBarsType.cs;$(NT8Custom)\BarsTypes\@RangeBarsType.cs"
             Link="NinjaTrader8\BarsTypes\%(Filename)%(Extension)" />
  </ItemGroup>
  <PropertyGroup>
    <DefineConstants>NINJASHIM_NT8_BARSTYPES;$(DefineConstants)</DefineConstants>
  </PropertyGroup>
</Project>
