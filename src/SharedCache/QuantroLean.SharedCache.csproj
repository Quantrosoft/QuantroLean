<Project Sdk="Microsoft.NET.Sdk">

  <!-- The bundled public BTCACHE holder + client: a resident process shares ONE in-memory copy of a backtest's input
       data across all concurrent runs (BTCACHE_PROTOCOL.md). Cross-platform (Windows named sections, Linux /dev/shm),
       no external dependencies, so it builds and runs on any OS a Lean clone runs on. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QuantroLeanCacheHolder</AssemblyName>
    <RootNamespace>QuantroLean.SharedCache</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
