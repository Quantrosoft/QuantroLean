<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MyLean Monte Carlo: resamples a strategy's closed-trade profits to estimate the distribution of its
    result metrics and risk measures. Self-contained, no NuGet or Lean dependency, deterministic for a given
    seed. See README.md in this folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>MyLean.MonteCarlo</RootNamespace>
    <AssemblyName>MonteCarlo</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>MyLean: Monte Carlo analysis of a strategy's closed-trade profits</Description>
  </PropertyGroup>
</Project>
